# cmc_to_sql/.env.example
# Copy this file to cmc_to_sql/.env and fill in the real values.
# .env is gitignored — NEVER commit it.
#
# Run the script with:  node --env-file=.env cmc-push.mjs
# (from the cmc_to_sql/ directory)

# Full URL of the deployed ingest-cmc Supabase edge function.
INGEST_URL=https://<project>.supabase.co/functions/v1/ingest-cmc

# Shared secret verified by ingest-cmc via the x-cron-secret request header.
# Must match the CRON_SECRET secret set in the Lovable Supabase dashboard.
CRON_SECRET=replace-with-real-cron-secret
