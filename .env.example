# WaterVoice DMV — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── Supabase (required) ────────────────────────────────────────────────────────
# Your Supabase project URL (visible in Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase public anon key (safe for browser — constrained by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase service role key (server-only — never expose to the client)
# Used by ingest.server.ts, rateLimit.server.ts, auth.functions.ts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same URL without VITE_ prefix — used by server functions at runtime
SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (used by auth.functions.ts publicClient)
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── App URL (required) ─────────────────────────────────────────────────────────
# Full URL of the deployed app — used for auth email redirect URLs.
# In development: http://localhost:8080
# In production: https://dc-water-watch.lovable.app
VITE_SITE_URL=http://localhost:8080
SITE_URL=http://localhost:8080

# ── Resend (required for email) ────────────────────────────────────────────────
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Anthropic (required for AI explanations) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Cron secret (required for ingestion endpoint) ─────────────────────────────
# Shared secret between Supabase pg_cron and POST /api/public/ingest
# Generate a random 32-char string: openssl rand -base64 32
CRON_SECRET=your-cron-secret

# ── Carto (public browser API key for vector tiles / client-side maps) ────────
# This key is embedded in the client bundle, so use Carto's publishable/public key.
VITE_CARTO_API_KEY=your-public-carto-api-key

# ── Map tiles (optional — defaults to OpenFreeMap, no API key needed) ─────────
VITE_MAP_TILE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_TILE_URL_DARK=https://tiles.openfreemap.org/styles/liberty-dark
